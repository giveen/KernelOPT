# KernelOPT environment. Copy to `.env` (or point $KERNELOPT_ENV_FILE at it).
# The real process environment always overrides these values, so
# `NINFER_REPO=x kernelopt ...` still wins over `.env`.
# `~` is expanded in path values.

# --- target checkouts -------------------------------------------------------
NINFER_REPO=~/ninfer
LLAMACPP_REPO=~/llama.cpp

# --- LLM provider -----------------------------------------------------------
KERNELOPT_PROVIDER=opencode-go
KERNELOPT_MODEL=deepseek-v4-pro
# KERNELOPT_BASE_URL=https://opencode.ai/zen/go/v1
# KERNELOPT_API_KEY=sk-...            # or set the provider-specific key below
OPENCODE_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# --- thinking level: none | minimal | low | medium | high (default: low) ----
KERNELOPT_REASONING_EFFORT=low

# --- engine E2E (Gate 3) ----------------------------------------------------
# Model to run the whole engine against, to prove a kernel change helps a real
# model. Accepts a path, a bare name, or `auto`; see `kernelopt models`.
# KERNELOPT_E2E_WEIGHTS=auto
# Where `kernelopt models` / `auto` look for local artifacts (colon-separated;
# `<repo>/models`, ./models and ~/models are always searched too).
# KERNELOPT_MODELS_DIR=~/ninfer/models:~/llama.cpp/models

# --- loop (written by `kernelopt wizard --save`) ----------------------------
# KERNELOPT_ITERATIONS=3
# KERNELOPT_BEAM=2
# KERNELOPT_PLANS=4
# KERNELOPT_RETRIES=4

# --- optional ---------------------------------------------------------------
# KERNELOPT_ENV_FILE=/path/to/another.env   # load a different env file
# KERNELOPT_RUNNER_DEBUG=1                  # trace the Python runner's exit paths
# KERNELOPT_GRAPH_SIGNAL_DIR=~/gs           # relocate the managed Graphsignal venv
# KERNELOPT_GRAPH_SIGNAL_SOURCE=git+https://github.com/giveen/graphsignal@main
# GRAPHSIGNAL_RUN=/path/to/graphsignal-run  # use an existing Graphsignal install
